// Scratch — data model (spec §7)
//
// NOTE ON ENUMS: the enum-like fields (sourceMode, origin, status, kind) are
// modelled as String with a documented set of allowed values, enforced in the
// validation layer (see src/lib/domain). Kept as strings on Postgres too for
// simplicity; they could be promoted to real Prisma enums later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A raw writing session — a 5–20 min dump or freewrite (spec §3/§4). Stored
/// whole and preserved forever; it is the SOURCE the snippets are extracted
/// from. The user segments it (human-in-the-loop) into paragraph snippets.
model Scratch {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") // owning Clerk user
  content    String // the raw text, verbatim
  label      String? // short descriptive (non-poetic) handle for the whole scratch
  sourceMode String   @map("source_mode") // "dump" | "freewrite" | "quick_capture"
  wordCount  Int      @map("word_count")
  createdAt  DateTime @default(now()) @map("created_at")

  snippets Snippet[]

  @@index([userId, createdAt])
  @@map("scratches")
}

/// A paragraph-sized unit extracted from a Scratch — the working currency.
/// Verbatim the user's words (extraction, never generated), plus a short
/// descriptive `label` to skim by. Never hard-deleted; shared by reference.
model Snippet {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") // owning Clerk user (denormalized for scoped queries)
  content    String
  label      String? // few descriptive words on what's in the paragraph
  order      Int      @default(0) @map("sort_order") // position within its scratch
  scratchId  String?  @map("scratch_id")
  archived   Boolean  @default(false) // out of the active consideration set (§3)
  createdAt  DateTime @default(now()) @map("created_at")
  sourceMode String   @map("source_mode") // mirrors the scratch's mode
  wordCount  Int      @map("word_count")

  // relations
  scratch         Scratch?         @relation(fields: [scratchId], references: [id], onDelete: Cascade)
  evidence        Evidence[]
  projectSnippets ProjectSnippet[]
  blockSnippets   BlockSnippet[] // blocks this snippet fills (shared, many-to-many)

  @@index([userId, archived])
  @@index([scratchId])
  @@map("snippets")
}

/// A candidate idea surfaced by the Ranker (or defined by the user).
/// `phrase` names TERRITORY, never a title/thesis (spec §5).
model Throughline {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // owning Clerk user
  phrase    String
  // A short, glanceable label for the thread (2–4 words, e.g. "speed vs depth").
  // Not a title/headline — just enough to scan the Sparks library at a glance.
  // Nullable: user-typed through-lines and pre-existing rows have none.
  title     String?
  origin    String // "ranker" | "user"
  status    String   @default("surfaced") // "surfaced" | "dismissed" | "promoted"
  createdAt DateTime @default(now()) @map("created_at")

  // relations
  evidence Evidence[]
  project  Project? // a throughline promotes to at most one project in v1

  @@index([userId, status])
  @@map("throughlines")
}

/// Why a through-line surfaced: an observation about the user's OWN words,
/// pointing at a specific snippet. Never a score, never a quality verdict.
model Evidence {
  id            String @id @default(cuid())
  throughlineId String @map("throughline_id")
  snippetId     String @map("snippet_id")
  observation   String // e.g. "returned to this 3×", "contrasts with snippet X"

  throughline Throughline @relation(fields: [throughlineId], references: [id], onDelete: Cascade)
  snippet     Snippet     @relation(fields: [snippetId], references: [id])

  @@index([throughlineId])
  @@map("evidence")
}

/// A piece being developed. A lens onto the shared snippet substrate.
model Project {
  id            String   @id @default(cuid())
  userId        String    @map("user_id") // owning Clerk user
  throughlineId String    @unique @map("throughline_id")
  title         String? // user-set, optional, deferred
  draft         String    @default("") // Editor working text (spec §8c)
  // "On the anvil" — a finish-by commitment (strike while the iron's hot). When
  // dueAt passes the piece goes cold; after a short grace it auto-releases.
  dueAt         DateTime? @map("due_at")
  status        String    @default("active") // active | finished | released
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  throughline     Throughline      @relation(fields: [throughlineId], references: [id])
  projectSnippets ProjectSnippet[]
  blocks          Block[]
  lintFlags       LintFlag[]

  @@index([userId, updatedAt])
  @@map("projects")
}

/// Join: a SHARED reference from a project to a snippet. The snippet is never
/// moved or deleted; "removing" from a project = setting included = false
/// ("move to bank"), spec §6/§8a.
model ProjectSnippet {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  snippetId String  @map("snippet_id")
  included  Boolean @default(true) // false = benched / in the bank
  relation  String  @default("unsure") // Filter colour: relates | unsure | unrelated

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snippet Snippet @relation(fields: [snippetId], references: [id])

  @@unique([projectId, snippetId])
  @@index([projectId])
  @@map("project_snippets")
}

/// Architect skeleton. A placeholder for shape/flow, not words (spec §8b).
/// Recursive from day one via parentBlockId so blocks can nest (chapters) later.
model Block {
  id            String  @id @default(cuid())
  projectId     String  @map("project_id")
  label         String
  body          String? // nullable until the user fills it
  order         Int     @map("sort_order")
  parentBlockId String? @map("parent_block_id")
  kind          String  @default("placeholder") // "placeholder" | "filled"

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Block?         @relation("BlockChildren", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children      Block[]        @relation("BlockChildren")
  blockSnippets BlockSnippet[] // the snippets filling this block, ordered
  lintFlags     LintFlag[]

  @@index([projectId])
  @@index([parentBlockId])
  @@map("blocks")
}

/// Join: a snippet placed into a block. A block can hold many snippets; a
/// snippet can fill many blocks (shared, never moved/copied). `order` is its
/// position within the block.
model BlockSnippet {
  id        String @id @default(cuid())
  blockId   String @map("block_id")
  snippetId String @map("snippet_id")
  order     Int    @default(0) @map("sort_order")

  block   Block   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  snippet Snippet @relation(fields: [snippetId], references: [id])

  @@unique([blockId, snippetId])
  @@index([blockId])
  @@map("block_snippets")
}

/// Editor semantic-linter flag (spec §8c). Surfaces an observation; the only
/// actions are fix-it-yourself or acknowledge & dismiss. Never supplies a fix.
model LintFlag {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  blockId   String? @map("block_id")
  range     String // serialized text range the flag applies to
  reason    String // e.g. "you postulate this without support"
  status    String  @default("open") // "open" | "acknowledged" | "resolved"

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("lint_flags")
}
